{
  "name": "dsh-jot",
  "version": "0.2.7",
  "description": "Human-editable notes, todos and documents for DeepSeek Harness, with search, tables, attachments, export and optional agent collaboration.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRODUCT.md",
    "assets/fonts",
    "assets/readme",
    "assets/icons",
    "docs/VALIDATION.md",
    "docs/GUIDE.zh-CN.md",
    "docs/GUIDE.en.md",
    "docs/community"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.2 || ^0.2.1-alpha.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "jot",
    "notes",
    "note-taking",
    "todo",
    "checklist",
    "rich-text",
    "tables",
    "attachments",
    "markdown",
    "pdf",
    "docx",
    "local-first",
    "agent-tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-host",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:read",
      "filesystem:write",
      "http:register",
      "tools:register",
      "native:open",
      "ui:extend"
    ],
    "compatibility": {
      "dshVersions": ["0.2.0-rc.2", "0.2.1-alpha.1"]
    },
    "capability": {
      "id": "dsh-jot",
      "kind": "ui",
      "invocation": "Open Jot in a synthetic workspace, create a public note, edit and save it, then reopen that note.",
      "expected": "The note retains the exact saved public text after reopening. AI collaboration remains off unless the human explicitly enables it."
    },
    "evidence": {
      "install": "docs/VALIDATION.md",
      "failureIsolation": null,
      "hotReload": null,
      "remove": "docs/VALIDATION.md"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "node --import tsx dev/server.ts",
    "icons": "node --import tsx dev/sync-icons.mts",
    "pack:check": "node scripts/pack-check.mjs",
    "prepack": "pnpm build && pnpm pack:check"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "docx": "9.5.1",
    "fflate": "0.8.2",
    "pdfkit": "0.17.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-native-command": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.4 || 3.18.5-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-native-command": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^22.19.0",
    "@types/pdfkit": "0.17.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.1-alpha.1"
  },
  "packageManager": "pnpm@11.22.0",
  "author": {
    "name": "Totoro",
    "url": "https://github.com/Totoro-qaq"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Totoro-qaq/dsh-jot.git"
  },
  "homepage": "https://github.com/Totoro-qaq/dsh-jot#readme",
  "bugs": {
    "url": "https://github.com/Totoro-qaq/dsh-jot/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
